    "@emotion/styled": "^11.14.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@mui/material": "^6.5.0",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/react": "^10.6.2",
