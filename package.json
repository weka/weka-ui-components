    "brace-expansion@^2.0.2": "^2.1.7",
    "browserslist": "^4.28.7",
    "fast-uri": "^3.1.6",
    "ip-address": "^10.3.1",
    "js-yaml": "^4.3.2",
    "lodash": "^4.18.1",
    "minimatch@10.0.3": "^10.2.3",
    "minimatch@10.1.2": "^10.2.3",
    "minimatch@^9.0.3": "^9.0.7",
    "minimatch@^9.0.4": "^9.0.7",
