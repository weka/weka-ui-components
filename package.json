{
  "name": "@weka/weka-ui-components",
  "repository": {
    "type": "git",
    "url": "https://github.com/weka/weka-ui-components.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "version": "4.69.2",
  "module": "lib/main.ts",
  "types": "lib/main.ts",
  "imports": {
    "#consts": "./lib/consts.ts",
    "#utils": "./lib/utils.tsx",
    "#hooks": "./lib/hooks/index.ts",
    "#context": "./lib/context/index.ts",
    "#svgs": "./lib/svgs/index.ts",
    "#types": "./lib/types/global.d.ts",
    "#v2/utils/textUtils": "./lib/v2/utils/textUtils.tsx",
    "#v2/utils/*": "./lib/v2/utils/*.ts",
    "#v2/hooks": "./lib/v2/hooks/index.ts"
  },
  "typesVersions": {
    "*": {
      "v2": [
        "./lib/v2/index.ts"
      ]
    }
  },
  "scripts": {
    "prepare": "husky",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -c .storybook",
    "predeploy-storybook": "yarn run build-storybook",
    "deploy-storybook": "gh-pages -d storybook-static",
    "typecheck": "tsc",
    "lintcheck": "eslint .",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "release:patch": "npm version patch && git push -u origin HEAD && git push --tags",
    "release:minor": "npm version minor && git push -u origin HEAD && git push --tags",
    "release:major": "npm version major && git push -u origin HEAD && git push --tags",
    "release:beta": "npm version prerelease --preid beta && git push -u origin HEAD && git push --tags"
  },
  "files": [
    "lib",
    "plugins",
    "dist"
  ],
  "exports": {
    ".": "./lib/main.ts",
    "./v2": {
      "types": "./lib/v2/index.ts",
      "development": "./lib/v2/index.ts",
      "default": "./dist/v2/index.js"
    },
    "./plugins": {
      "types": "./plugins/index.d.ts",
      "default": "./plugins/index.js"
    },
    "./eslint": "./plugins/eslint/index.js",
    "./eslint-diff": "./plugins/eslint/diff.js",
    "./stylelint": "./plugins/stylelint/index.js",
    "./prettier-config": "./plugins/prettier/index.json",
    "./typescript-config": "./plugins/typescript/tsconfig.base.json",
    "./lib/*": "./lib/*"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/language": "^6",
    "@codemirror/lint": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.19",
    "ace-builds": "^1.44.0",
    "check-password-strength": "^2.0.7",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^3.3.3",
    "luxon": "^3.7.2",
    "react-ace": "^15.0.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "react-toastify": "^9.1.3",
    "simplebar-react": "^3.3.2",
    "sonner": "2.0.7"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^5.11.1 || ^6.5.0",
    "luxon": "^3.7.2",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-router-dom": "^6.6.2 || ^7.18.0",
    "recharts": "^2.15.4"
  },
  "lint-staged": {
    "**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "**/*.{ts,tsx,js,jsx,css,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.5.1",
